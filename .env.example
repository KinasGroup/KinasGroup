# KINAS GROUP - Environment Configuration
# Copy to .env and replace placeholders with real values.

APP_NAME="KINAS GROUP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kinas-group.com

# =======================
# Database
# =======================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kinas_group
DB_USER=root
DB_PASS=

# =======================
# Google reCAPTCHA
# =======================
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# =======================
# Termii SMS / OTP
# Sign up at https://termii.com
# Sender ID: register a dedicated sender or use the default "N-Alert"
# (NCC has flagged some default sender IDs in 2024-2025 — prefer
# a properly-registered custom sender ID for production)
# =======================
TERMII_ENABLED=true
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=KINAS
TERMII_CHANNEL=generic
TERMII_API_BASE=https://api.ng.termii.com

# Per-event SMS notification switches
SMS_NOTIFY_KYC_DECISION=true
SMS_NOTIFY_NEW_MESSAGE=true
SMS_NOTIFY_LISTING_APPROVED=true
SMS_NOTIFY_NEW_INQUIRY=true
SMS_NOTIFY_ADMIN_NEW_AGENT=false

# =======================
# Resend (email)
# =======================
RESEND_API_KEY=

# =======================
# MetaMap (KYC)
# https://dashboard.metamap.com
# =======================
METAMAP_ENABLED=true
METAMAP_CLIENT_ID=your_client_id_here
METAMAP_CLIENT_SECRET=your_client_secret_here
METAMAP_WEBHOOK_SECRET=your_webhook_signing_secret_here
METAMAP_FLOW_ID=your_flow_id_here
METAMAP_API_BASE=https://api.getmati.com

# =======================
# Cloudflare R2 Storage
# =======================
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_FALLBACK_TO_LOCAL=true
R2_MAX_UPLOAD_SIZE=10485760
R2_IMAGE_QUALITY=85
R2_THUMBNAIL_WIDTH=400
R2_MAX_IMAGE_WIDTH=1920
R2_MAX_IMAGE_HEIGHT=1080
