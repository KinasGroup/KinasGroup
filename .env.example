# KINAS GROUP - Environment Configuration
# Copy to .env and replace placeholders with real values.

APP_NAME="KINAS GROUP"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kinas-group.com

# =======================
# Database
# =======================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kinas_group
DB_USER=root
DB_PASS=

# =======================
# Google reCAPTCHA
# =======================
# Default pair — used for kinas-group.com and as a fallback for any
# domain without its own pair below.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Per-division pairs. Each MUST be registered in the Google reCAPTCHA
# admin console against that division's own domain (e.g. kinasvolt.com
# + www.kinasvolt.com), NOT kinas-group.com. Resolved at runtime by
# includes/security.php based on the X-Original-Host header the
# Cloudflare Worker sends.
CAPTCHA_SITE_KEY_KINASVOLT=
CAPTCHA_SECRET_KEY_KINASVOLT=
CAPTCHA_SITE_KEY_KINASAUTO=
CAPTCHA_SECRET_KEY_KINASAUTO=
CAPTCHA_SITE_KEY_KINASSTORE=
CAPTCHA_SECRET_KEY_KINASSTORE=
CAPTCHA_SITE_KEY_WILLIAMS=
CAPTCHA_SECRET_KEY_WILLIAMS=

# =======================
# Termii SMS / OTP
# Sign up at https://termii.com
# Sender ID: register a dedicated sender or use the default "N-Alert"
# (NCC has flagged some default sender IDs in 2024-2025 — prefer
# a properly-registered custom sender ID for production)
# =======================
TERMII_ENABLED=true
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=KINAS
TERMII_CHANNEL=generic
TERMII_API_BASE=https://api.ng.termii.com

# Per-event SMS notification switches
SMS_NOTIFY_KYC_DECISION=true
SMS_NOTIFY_NEW_MESSAGE=true
SMS_NOTIFY_LISTING_APPROVED=true
SMS_NOTIFY_NEW_INQUIRY=true
SMS_NOTIFY_ADMIN_NEW_AGENT=false

# =======================
# Resend (email)
# =======================
RESEND_API_KEY=

# =======================
# MetaMap (KYC)
# https://dashboard.metamap.com
# =======================
METAMAP_ENABLED=true
METAMAP_CLIENT_ID=your_client_id_here
METAMAP_CLIENT_SECRET=your_client_secret_here
METAMAP_WEBHOOK_SECRET=your_webhook_signing_secret_here
METAMAP_FLOW_ID=your_flow_id_here
METAMAP_API_BASE=https://api.getmati.com

# =======================
# Paystack (card payments — KINAS Marketplace checkout)
# https://dashboard.paystack.com/#/settings/developers
# Set the webhook URL in the dashboard to:
#   https://kinas-group.com/api/webhooks/paystack.php
# =======================
PAYSTACK_ENABLED=true
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_API_BASE=https://api.paystack.co
# When true, the Paystack processing fee is added on top of the listing
# price at checkout (shown as a separate "Card processing fee" line item)
# so agents/platform receive the full listed price. When false, the
# platform absorbs the fee out of its commission.
PAYSTACK_PASS_FEES_TO_BUYER=true

# =======================
# Didit (KYC + KYB verification)
# https://business.didit.me → API & Webhooks
# Two SEPARATE workflows, each created in the Didit Console:
#   - a "KYC" workflow (ID scan + liveness + face match) → DIDIT_KYC_WORKFLOW_ID
#   - a "KYB" workflow (registry + UBOs + company AML)   → DIDIT_KYB_WORKFLOW_ID
# Webhook URL to configure in the console:
#   https://kinas-group.com/api/webhooks/didit.php
# (MetaMap remains configured below for historical verifications only —
# new verifications use Didit.)
# =======================
DIDIT_ENABLED=true
DIDIT_API_KEY=your_didit_api_key_here
DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret_here
DIDIT_KYC_WORKFLOW_ID=your_kyc_workflow_id_here
DIDIT_KYB_WORKFLOW_ID=your_kyb_workflow_id_here
DIDIT_API_BASE=https://verification.didit.me/v3

# =======================
# Cloudflare R2 Storage
# =======================
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_FALLBACK_TO_LOCAL=true
R2_MAX_UPLOAD_SIZE=10485760
R2_IMAGE_QUALITY=85
R2_THUMBNAIL_WIDTH=400
R2_MAX_IMAGE_WIDTH=1920
R2_MAX_IMAGE_HEIGHT=1080
