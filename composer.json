{
    "name": "kinasgroup/kinas-group",
    "description": "KINAS GROUP - Luxury Marketplace",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "mpdf/mpdf": "^8.3",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"echo '✅ Dependencies installed successfully!\\n';\""
        ]
    }
}
